#!/bin/bash -e
# Build time configuration of the MariaDB component, run by fab inside the
# chroot after the overlay is applied (share/product.mk, "run the unit
# configuration scripts"). It runs once per image: a layer built on a parent
# that already carries this unit does not run it again, which is what
# bt-layer's units field in the layer manifest is for.
#
# Extracted from conf/mysql of the shared tree. Two changes, both named in
# the changelog: the init script directory below is an overridable default,
# so the script can be run against scratch directories and measured
# (decision 0004), and mysqltuner is no longer downloaded here.
#
# The shared tree fetched mysqltuner.pl, basic_passwords.txt and
# vulnerabilities.csv from the master branch of jmrenouard/MySQLTuner-perl
# into /usr/local/bin: whatever that branch held on the day of the build,
# with nothing pinned and nothing checked. Debian trixie packages it
# (mysqltuner 2.6.0), so it is in the plan now and apt verifies it like
# every other package. The package installs /usr/bin/mysqltuner and keeps
# the two data files in /usr/share/mysqltuner, where it looks for them.
# tests/conf.bats fails if this script fetches anything again.

INITD="${INITD:-/etc/init.d}"

# As of Debian Buster, there is no longer a /etc/init.d/mysql script, so let's
# link the mariadb one.
ln -s "$INITD/mariadb" "$INITD/mysql"

# secure mysql installation
service mysql start
mysql <<EOF
USE mysql;
# remove anonymous users
DELETE FROM user WHERE User='';

# remove remote root
DELETE FROM user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');

# remove test database
DROP DATABASE IF EXISTS test;
DELETE FROM db WHERE Db='test' OR Db='test\\_%';
EOF
service mysql stop
